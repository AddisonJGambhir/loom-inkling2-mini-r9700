#!/bin/bash
# inkling-r9700 - Inkling-2-Mini on one AMD Radeon AI PRO R9700 with AMD Loom.
#   inkling-r9700 install   venv + hrx-loom (default 0.3.0), then download the weights (~19 GB) with loom-fetch
#   inkling-r9700 start     serve as model "local" on http://127.0.0.1:1234/v1 (OpenAI + llama.cpp-style /props)
#   inkling-r9700 stop | status | logs
# Layout: client -> :1234 proxy (alias "local", /props, image/memory retries) -> loom-serve :11437 on the R9700.
# Env: INKLING_HOME (default ~/.local/share/inkling-r9700), INKLING_PORT (1234), INKLING_BACKEND_PORT (11437),
#      INKLING_DEVICE (amdgpu://id/<32 hex>; default: the first gfx1201 GPU), INKLING_MEMORY (Loom pool, default 32256mib),
#      INKLING_LOOM_VERSION (default 0.3.0; 0.2.0 also supported), INKLING_SPIN_NS (default 4294967295),
#      INKLING_PROFILE: "default" (1 chat, 448K, drafter on) or "concurrent" (up to 4 chats x 262K, drafter off, proxy KV
#      budget guard + decode priority + system-prompt checkpoints; INKLING_CTX / INKLING_TOKEN_BUDGET /
#      INKLING_SESSION_CACHE / INKLING_DECODE_PRIORITY override 262144 / 450000 / 0 / 1).
set -u
HERE="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
H="${INKLING_HOME:-$HOME/.local/share/inkling-r9700}"
VENV="$H/venv"; MODEL="$H/model"
PORT="${INKLING_PORT:-1234}"; BPORT="${INKLING_BACKEND_PORT:-11437}"
# 32256 MiB = 31.5 GiB of the card's 31.86 GiB. Lower it (e.g. 30gib) if the R9700 also drives a display.
MEM="${INKLING_MEMORY:-32256mib}"
LOOM_VERSION="${INKLING_LOOM_VERSION:-0.3.0}"
SPIN_NS="${INKLING_SPIN_NS:-4294967295}"
UB=inkling-backend; UP=inkling-proxy; UW=inkling-watchdog
PROFILE="${INKLING_PROFILE:-default}"
c_g=$'\e[32m'; c_r=$'\e[31m'; c_0=$'\e[0m'
die() { echo "${c_r}inkling-r9700: $*${c_0}" >&2; exit 1; }

cmd_install() {
  local py; py=$(command -v python3) || die "python3 (>= 3.12) not found"
  "$py" -c 'import sys; sys.exit(sys.version_info < (3, 12))' || die "python3 >= 3.12 required (hrx-loom wheel)"
  mkdir -p "$H"
  [[ -x "$VENV/bin/loom-serve" ]] || {
    echo "installing hrx-loom $LOOM_VERSION into $VENV"
    "$py" -m venv "$VENV" && "$VENV/bin/pip" install --quiet --upgrade pip && "$VENV/bin/pip" install --quiet "hrx-loom[hf]==$LOOM_VERSION" \
      || die "pip install hrx-loom failed (needs x86_64 Linux with glibc >= 2.39)"; }
  echo "downloading Inkling-2-Mini (Unsloth UD-Q4_K_XL + DSpark drafter + BF16 mmproj, ~19 GB) into $MODEL"
  "$VENV/bin/loom-fetch" "$HERE/package/model.json" --output "$MODEL" --no-input --no-lock || die "loom-fetch failed"
  # the repo's programs are the source of truth: refresh them on every install
  cp "$HERE"/package/program/*.loom "$MODEL/program/" && cp "$HERE/package/model.json" "$MODEL/model.json"
  echo "${c_g}installed.${c_0} next: $0 start"
}

find_device() {
  [[ -n "${INKLING_DEVICE:-}" ]] && { echo "$INKLING_DEVICE"; return; }
  "$VENV/bin/amdf-info" --format=json 2>/dev/null | python3 -c '
import json, sys
gpus = [e for e in json.load(sys.stdin).get("endpoints", []) if e.get("gpu", {}).get("target") == "gfx1201"]
if not gpus: sys.exit(1)
if len(gpus) > 1: print("note: several gfx1201 GPUs; using the first (set INKLING_DEVICE to pick)", file=sys.stderr)
print("amdgpu://id/" + gpus[0]["id"])'
}

backend_status() { curl -s -m 3 "http://127.0.0.1:$BPORT/v1/status" 2>/dev/null; }

cmd_start() {
  [[ -x "$VENV/bin/loom-serve" && -r "$MODEL/model.json" ]] || die "not installed - run: $0 install"
  systemctl --user is-active -q "$UB" && { echo "already running - $0 status / $0 stop"; exit 0; }
  ss -Htln "( sport = :$PORT )" | grep -q . && die "port $PORT is busy (set INKLING_PORT)"
  local dev; dev=$(find_device) || die "no gfx1201 (R9700) GPU found - check: $VENV/bin/amdf-info"
  systemctl --user reset-failed "$UB" "$UP" "$UW" >/dev/null 2>&1
  local card="$MODEL/model.json" nctx=458752 penv=()
  case "$PROFILE" in
    default) ;;
    concurrent)
      # Loom 0.2.0 shares one elastic KV pool across rows (~17.4 KB/token with the drafter off) and fails the whole
      # model if live conversations overcommit it, so the proxy admits chats against a token budget instead.
      # Prefix-cache endpoints are never evicted and block reclaim of idle histories: off. Turn-to-turn reuse comes
      # from the idle rows; new conversations reuse a shared system prompt through proxy-managed checkpoints.
      nctx="${INKLING_CTX:-262144}"; card="$MODEL/model-concurrent.json"
      local scache="${INKLING_SESSION_CACHE:-0}"
      python3 -I - "$MODEL/model.json" "$card" "$nctx" "$scache" <<'PY' || die "could not write $card"
import json, sys
d = json.load(open(sys.argv[1]))
ex = d["presets"]["chat"]["execution"]
ex.update(rows=4, max_sessions=4, context_capacity=int(sys.argv[3]), max_tokens=48000, draft_depth=0,
          prefix_cache_capacity=0, session_cache_capacity=int(sys.argv[4]), cache_target_bytes=2147483648, checkpoint_capacity=2)
json.dump(d, open(sys.argv[2], "w"), indent=2)
PY
      penv=(-E LOOM_MAX_SESSIONS=4 -E "LOOM_TOKEN_BUDGET=${INKLING_TOKEN_BUDGET:-450000}" -E LOOM_MAX_TOKENS=48000
            -E LOOM_CHECKPOINT_CAPACITY=2 -E LOOM_SYS_CHECKPOINT=1
            -E "LOOM_DECODE_PRIORITY=${INKLING_DECODE_PRIORITY:-1}") ;;
    *) die "unknown INKLING_PROFILE '$PROFILE' (default | concurrent)" ;;
  esac
  echo "starting Loom on $dev ($PROFILE profile, $nctx ctx, KV int8, image input; first start compiles ~2000 kernels, a few minutes)"
  # io_uring blocked: Loom then loads the weights without keeping a second copy in system RAM.
  systemd-run --user --quiet --unit="$UB" --working-directory="$H" \
    -p SystemCallFilter=~io_uring_setup -p SystemCallErrorNumber=ENOSYS \
    "$VENV/bin/loom-serve" --model="$card" "--device=$dev?completion_spin_ns=$SPIN_NS" \
    --state_slab_bytes=4mib --weight_slab_bytes=64mib --memory_bytes="$MEM" --listen="127.0.0.1:$BPORT" || die "systemd-run failed"
  local t0=$SECONDS s
  while :; do
    s=$(backend_status)
    grep -q '"phase":"idle"' <<<"$s" && break
    if grep -qE '"phase":"failed"|"registration":"failed"' <<<"$s" || ! systemctl --user is-active -q "$UB"; then
      journalctl --user -u "$UB" -n 15 -o cat --no-pager | cut -c1-300; systemctl --user stop "$UB"; die "Loom failed to load"; fi
    (( SECONDS - t0 > 1800 )) && { systemctl --user stop "$UB"; die "timed out loading"; }
    sleep 2
  done
  # pinned weights stay resident; an oversized request is then refused instead of evicting the model
  curl -s -m 60 -X POST -H 'Content-Type: application/json' -d '{"model":"Inkling-2-Mini"}' "http://127.0.0.1:$BPORT/v1/models/pin" >/dev/null
  systemd-run --user --quiet --unit="$UP" -E "LOOM_NCTX=$nctx" -E LOOM_VISION=1 "${penv[@]}" \
    python3 -I "$HERE/bin/proxy.py" "$PORT" "$BPORT" Inkling-2-Mini
  systemd-run --user --quiet --unit="$UW" "$HERE/bin/loom-watchdog.sh" "$BPORT" Inkling-2-Mini "$UB" "$UP"
  sleep 1
  echo "${c_g}ready${c_0} in $((SECONDS - t0))s - http://127.0.0.1:$PORT/v1  model 'local'  ($PROFILE: $nctx ctx, images)"
}

cmd_stop() { systemctl --user stop "$UW" "$UP" "$UB" 2>/dev/null; echo "stopped"; }
cmd_status() {
  for u in "$UB" "$UP" "$UW"; do printf "%-17s %s\n" "$u" "$(systemctl --user is-active "$u")"; done
  backend_status | grep -oE '"registration":"[a-z]+"|"pinned":(true|false)|"active_requests":[0-9]+' | head -3 | tr '\n' ' '; echo
}
cmd_logs() { exec journalctl --user -f -n 30 -o cat -u "$UP" -u "$UB"; }

case "${1:-}" in
  install) cmd_install ;; start) cmd_start ;; stop) cmd_stop ;; status) cmd_status ;; logs) cmd_logs ;;
  restart) cmd_stop; cmd_start ;;
  *) sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
